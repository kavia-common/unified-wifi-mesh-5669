{"is_source_file": true, "format": "C++", "description": "This file contains implementation of functions for managing and querying WiFi network, device, radio, BSS, and station information via a bus communication framework. It includes numerous helper functions to retrieve specific parameters, construct data models, and handle asynchronous callbacks for a network management system.", "external_files": ["em_ctrl.h", "tr_181.h"], "external_methods": ["em_ctrl_t::get_first_dm", "g_ctrl.get_ctrl_al_interface", "g_ctrl.get_network", "g_ctrl.get_next_dm", "hash_map_get_first", "hash_map_get_next", "dm_easy_mesh_t::macbytes_to_string", "dm_easy_mesh_t::string_to_macbytes"], "published": ["network_get", "ssid_get", "ssid_tget", "device_get", "device_tget", "radio_get", "radio_tget", "rbhsta_get", "rcaps_get", "curops_get", "curops_tget", "bss_get", "bss_tget", "sta_get", "sta_tget"], "classes": [{"name": "em_ctrl_t", "description": "Controller class managing network devices, radios, and associated elements, providing methods to retrieve network information and handle data fetching callbacks."}], "methods": [{"name": "get_table_instance", "description": "Extracts an instance identifier from a string, indicating whether it is a number or a string-based ID."}, {"name": "get_dm_easy_mesh", "description": "Retrieves a specific dm_easy_mesh_t instance based on an instance identifier, either by index or MAC address."}, {"name": "get_dm_dev", "description": "Finds a device within the mesh network based on device and backhaul MAC addresses."}, {"name": "get_dm_radio", "description": "Retrieves a specific radio instance within a mesh device based on an identifier."}, {"name": "get_dm_bh_sta", "description": "Finds the backhaul station corresponding to a given radio in the mesh network."}, {"name": "get_dm_curop", "description": "Retrieves the currently active operational class for a specific radio in the mesh network."}, {"name": "get_dm_bss", "description": "Finds a BSS (Basic Service Set) within a mesh radio based on an index or MAC address."}, {"name": "get_dm_sta", "description": "Retrieves STA (Station) info within a BSS by index or MAC address."}, {"name": "fill_comma_sep", "description": "Concatenates an array of short strings into a comma-separated string."}, {"name": "fill_haul_type", "description": "Fills an array with string representations of haul (link) types."}, {"name": "raw_data_set (overloads)", "description": "Utility functions to populate raw_data_t structures with different data types (boolean, int, string, MAC, WiFi variant, property)."}, {"name": "property_init_value", "description": "Initializes a property with a root, index, parameter, and value."}, {"name": "property_append_tail", "description": "Appends a new property to a list of properties, forming a tail."}, {"name": "network_get_inner", "description": "Fetches network-level information such as ID, ControllerID, and device count."}, {"name": "device_get_inner", "description": "Retrieves device-specific information including identification, manufacturing data, backhaul info, and radio info."}, {"name": "ssid_get_inner", "description": "Gets details about SSID configurations like SSID name, band, enabling status, security settings, etc."}, {"name": "ssid_tget_inner", "description": "Retrieves a list of all SSID configurations with their properties."}, {"name": "device_tget_inner", "description": "Retrieves detailed info for all devices in the network."}, {"name": "bss_get_inner", "description": "Retrieves BSS details such as BSSID, SSID, and usage flags for a given radio."}, {"name": "sta_get_inner", "description": "Retrieves station info such as MAC, capabilities, rates, signal strength, and statistics."}, {"name": "radio_tget_params", "description": "Populates properties for radios within a given mesh network."}, {"name": "radio_tget_inner", "description": "Handles callback to retrieve radio parameters and fill property list."}, {"name": "rbhsta_get_inner", "descrip